# Copy to `.env` and edit. Only the host paths are required; everything else
# has a working default (the distributed-local defaults match `make farm-up`).
#
# Bring-up is one unified docker-compose.yml with two profiles:
#   master box:  make farm-up                            (cluster + server + worker)
#   worker box:  docker compose --profile worker up -d  (worker only; see below)

# --- Host paths (REQUIRED) -------------------------------------------------
# Directories on the host that get bind-mounted into the encoder container
# and, via HOST_* env, into the worker containers.
SOURCE_DIR=/path/to/your/source/videos
OUTPUT_DIR=/path/to/encoded/output
TMP_DIR=/path/to/tmp/scratch

# --- Server behavior (optional) --------------------------------------------
# AUTO_WATCH=true                # auto-submit new files dropped into SOURCE_DIR
# DEFAULT_TARGET=local           # local | cloud  (the two run modes; the old
#                                # local-dist / cloud-batch values still work)
# DEFAULT_CODEC=both             # h264 | hevc | both | all
# DEFAULT_MAX_RES=               # e.g. 1080p; empty = no limit (all rungs)
# MAX_CONCURRENT=1               # concurrent jobs the server runs at once

# --- Distributed-local encode (target local) -------------------------------
# Chunked encoding across one or more LAN machines via Temporal + MinIO — no
# AWS. On the master, `make farm-up` brings up the whole `master` profile (cluster
# + server + one local worker) in one compose command. The defaults below match
# a single-machine master, so a solo master needs none of them.
# TEMPORAL_ADDRESS=host.docker.internal:7233        # Temporal server (master: host.docker.internal)
# TEMPORAL_UI_ADDR=http://host.docker.internal:8233 # Temporal UI (worker discovery)
# MINIO_ENDPOINT=http://host.docker.internal:9000   # shared chunk/blob store
# MINIO_ACCESS_KEY=encoder                          # ALSO becomes MinIO's root user
# MINIO_SECRET_KEY=encoder-secret                   # ALSO becomes MinIO's root password
# DIST_S3_BUCKET=encoder-local                      # MinIO bucket for staging
# LOCAL_WORKER_LABEL=mac                            # label for the master's own worker
# DIST_WORKER_CONTAINER=encode-worker               # worker container name (dist.go toggle contract)
# ENCODE_SLOTS=                                     # worker concurrency; empty = detect cores
#                                                   # (Mac master: `make farm-up` auto-sizes from P-cores)
# DIST_WORKERS=                                     # remote boxes as "label=ssh_target"
#                                                   # pairs, e.g.
#                                                   # ubuntu=you@ubuntu-box.local
# MASTER_IP=                                         # REQUIRED if DIST_WORKERS is set:
#                                                   # this master's LAN IP, which remote
#                                                   # workers dial for Temporal/MinIO.
#                                                   # (defaults to a placeholder — wrong
#                                                   # on your network, workers silently
#                                                   # never connect. `make doctor` warns.)
#
# On an EXTRA worker box (no source dirs, no cluster — just cores), set the two
# addresses to the master's LAN IP and bring up ONLY the worker profile:
#   TEMPORAL_ADDRESS=192.168.1.10:7233
#   S3_ENDPOINT_URL=http://192.168.1.10:9000
#   MINIO_ACCESS_KEY=encoder   MINIO_SECRET_KEY=encoder-secret   # match the master
#   docker compose --profile worker up -d

# --- Cloud encode (target cloud-batch) -------------------------------------
# Chunked fan-out on AWS Batch spot (Graviton). Stand the stack up once with
# `make cloud-up` (needs an existing S3 bucket + AWS creds). ECR_REPO /
# STATE_MACHINE_ARN / DOCKER_IMAGE are normally resolved from Terraform state,
# but can be pinned here.
# AWS_REGION=us-west-2
# S3_BUCKET=                      # existing bucket for job staging (prerequisite)
# STATE_MACHINE_ARN=             # auto-resolved from `tofu output`; set only to override
# WARM_MIN_VCPUS=8               # keep this many Batch vCPUs warm during a run

# --- Image / registry (optional) -------------------------------------------
# GHCR_PAT is a classic PAT with write:packages scope, needed on the MASTER only
# to `make publish` (push the image). The published package is PUBLIC, so pulling
# it — on this box or any worker — needs NO auth; workers are never handed the
# PAT. DOCKER_IMAGE is the ref the About tab reads for the cloud image version;
# it defaults to the ECR image from Terraform.
# GHCR_PAT=
# DOCKER_IMAGE=ghcr.io/jonathaneoliver/infinite-streaming-encoder:latest

# --- Promote staged output -> live locations (optional) --------------------
# PROMOTE_DESTS=                 # rsync destinations for finished output
# PROMOTE_LOCAL_DIR=             # host dir mounted at /media/promote-local
# PROMOTE_SSH_HOST=              # a *.local remote, resolved via mDNS
