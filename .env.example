# Copy to `.env` and edit. Required paths have no defaults.

# --- Host paths (REQUIRED) -------------------------------------------------
# Directories on the host that get bind-mounted into the encoder container
# and, via HOST_* env, into sibling worker containers.
SOURCE_DIR=/path/to/your/source/videos
OUTPUT_DIR=/path/to/encoded/output
TMP_DIR=/path/to/tmp/scratch

# --- Server behavior (optional) --------------------------------------------
# AUTO_WATCH=true
# DEFAULT_TARGET=local           # local | cloud
# DEFAULT_CODEC=both             # h264 | hevc | both | all
# DEFAULT_MAX_RES=               # e.g. 1080p; empty = no limit
# MAX_CONCURRENT=1

# --- Cloud encode (only if DEFAULT_TARGET=cloud or running cloud jobs) -----
# AWS_REGION=us-west-2
# S3_BUCKET=
# SUBNET_ID=
# SECURITY_GROUP_ID=
# INSTANCE_PROFILE=encode-worker
# INSTANCE_TYPE=c7i.xlarge
# GHCR_PAT=
# DOCKER_IMAGE=ghcr.io/jonathaneoliver/infinite-streaming:latest
