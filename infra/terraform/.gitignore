# Terraform state lives in S3 (configured in versions.tf) — local
# scratch files shouldn't be checked in.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
crash.log
crash.*.log

# Plan output
*.tfplan

# Variable overrides with secrets
*.auto.tfvars
*.tfvars
backend_override.tf

# tofu plan artifact from `make infra-plan`
tf.plan

# Written by cloud-dev-up: the image tag cloud ran BEFORE the test apply, so
# cloud-dev-down can restore it exactly. Local state about a local experiment.
.cloud-dev-prev-tag
