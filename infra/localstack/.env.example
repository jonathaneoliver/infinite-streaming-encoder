# Copy to `.env` (gitignored) and fill in. Docker Compose auto-loads .env
# from this directory. NEVER commit the real token.

# --- Community (S3 only) — the default; leave these unset ---
# LOCALSTACK_IMAGE=localstack/localstack:3
# LOCALSTACK_SERVICES=s3

# --- Pro (unlocks AWS Batch + Step Functions) ---
# Get the token from https://app.localstack.cloud → Auth Tokens
# LOCALSTACK_AUTH_TOKEN=ls-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LOCALSTACK_IMAGE=localstack/localstack-pro:3
# LOCALSTACK_SERVICES=s3,batch,stepfunctions,iam,logs,ecr
