# Copy to worker.env on each worker box and fill in. The master box's LAN IP is
# where Temporal (:7233) and MinIO (:9000) are published by docker-compose.yml.
TEMPORAL_ADDRESS=192.168.0.110:7233
S3_ENDPOINT_URL=http://192.168.0.110:9000
AWS_ACCESS_KEY_ID=encoder
AWS_SECRET_ACCESS_KEY=encoder-secret
AWS_REGION=us-east-1

# Max concurrent encodes on this box. Rule of thumb: cores / 2 (x265 ~half-fills
# a box per encode). Leave blank to auto-size.
ENCODE_SLOTS=

# Image to run the worker from. On the master (Mac) this is the locally-built
# encoder:latest. On a box whose image is stale, point CODE_MOUNT at a synced
# checkout of scripts/encoder to run current code over it.
ENCODER_IMAGE=encoder:latest
# CODE_MOUNT=/tmp/encoder-src/encoder
WORKER_NAME=encode-worker
