/server
# `.env` alone matches only that exact name — any sibling (.env.bak-*, .env.local,
# .env.prod) held real credentials and was fully committable.
.env
.env.*
!.env.example
.DS_Store
__pycache__/
*.pyc

# Auto-generated agent memory/session journal — local only, not source.
.memsearch/

# Playwright MCP browser-automation console logs — local only, not source.
.playwright-mcp/

# Written by publish-tag: the tag it last pushed, so `make promote` needs no
# argument. Local state about a local action.
.last-published-tag

# transient Claude worktrees
.claude/worktrees/
# untracked comparison doc — never commit
ENCODER_COMPARISON.md

# Screenshots taken while debugging the UI — the browser tool writes these
# into the repo root when no output dir is given.
fleet-lanes.png
*.playwright.png

# The demo recorders need playwright. Everything else they produce goes to
# $DEMO_DIR (outside the repo) by design — only tools/demo/narrative/ is
# tracked, because the script is source and the 130 MB of video is not.
tools/demo/node_modules/

# Generated by narrator_app: voice samples and per-cue audio. Regenerated on
# demand from the TTS, keyed by text hash — never worth committing.
tools/demo/samples/
